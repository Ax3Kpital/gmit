# GMIT — Environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. This file (.env.example) has names only.

# ─── Database ────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Docker Compose default shown)
DATABASE_URL=postgresql://gmit:gmit@postgres:5432/gmit

# ─── Application ─────────────────────────────────────────────────────────────

# Secret key for session token signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Allowed CORS origins (JSON array string)
CORS_ORIGINS=["http://localhost:3001"]

# Environment: development | production
APP_ENV=development

# ─── AI Providers ────────────────────────────────────────────────────────────

# Which LLM provider to use: mock | anthropic | openai
# mock requires no API key and is safe for local development
LLM_PROVIDER=mock

# Anthropic API key (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenAI API key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ─── Macro Data Providers ────────────────────────────────────────────────────

# FRED (Federal Reserve Bank of St. Louis) — register at fred.stlouisfed.org
# Required for Phase 2 macro data. App boots without it (series show UNAVAILABLE).
FRED_API_KEY=

# EIA (U.S. Energy Information Administration) — register at eia.gov
# Required for energy data. App boots without it.
EIA_API_KEY=

# ─── Market Data Providers ───────────────────────────────────────────────────

# Alpha Vantage — verify terms before use (see DATA_SOURCE_REGISTER.md)
# UNVERIFIED: do not use in production until license is confirmed
ALPHA_VANTAGE_API_KEY=

# ─── Notification Providers ──────────────────────────────────────────────────

# Email (SMTP) — for alert events + daily briefing
# Works with Gmail (use App Password), SendGrid, Mailgun, Resend, Brevo, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=GMIT Terminal <your@gmail.com>
# Where to send notifications (your personal email)
NOTIFICATION_EMAIL=

# Telegram bot — instant personal notifications (free, no business approval)
# Setup: message @BotFather → /newbot → copy the token
# Get your chat ID: message @userinfobot, or check getUpdates after /start
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Cloud Deployment ────────────────────────────────────────────────────────

# Your domain for Caddy automatic HTTPS (Let's Encrypt)
DOMAIN=gmit.yourdomain.com

# Postgres credentials — change from defaults in production!
POSTGRES_USER=gmit
POSTGRES_PASSWORD=
POSTGRES_DB=gmit

# ─── Frontend ────────────────────────────────────────────────────────────────

# Public API URL (accessible from browser)
NEXT_PUBLIC_API_URL=http://localhost:8001

# Internal API URL (server-side Next.js calls inside Docker network)
API_URL=http://backend:8000
